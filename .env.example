NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Leave MONGODB_URI empty to use process-local synthetic demo data.
MONGODB_URI=
# Required for production. Use a long, unique secret.
JWT_SECRET=

# Optional. Without SMTP_URL, email is not sent; demo reset tokens are returned in development.
SMTP_URL=
EMAIL_FROM=Sanjeevani Health Care Hospital Management System <care@example.com>

# Required only for the one-time MongoDB administrator bootstrap command.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=